{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The bundled Settings window only (settings.html). No `remote` entry and no other window: neither the server's pages nor the other bundled windows get these commands.",
  "local": true,
  "windows": ["settings"],
  "permissions": [
    "allow-settings-get",
    "allow-settings-open-account",
    "allow-settings-reset-zoom",
    "allow-settings-close",
    "allow-settings-set-shortcut",
    "allow-settings-set-leader-letter",
    "allow-settings-record-shortcut",
    "allow-settings-set-toggle",
    "allow-settings-set-voice-language",
    "allow-settings-remove-voice-model",
    "allow-settings-set-update-channel",
    "allow-settings-check-for-updates",
    "allow-settings-restart-to-update",
    "allow-settings-servers",
    "allow-settings-rename-server",
    "allow-settings-move-server",
    "allow-settings-switch-server",
    "allow-settings-sign-out-server",
    "allow-settings-forget-server",
    "allow-settings-add-server"
  ]
}
