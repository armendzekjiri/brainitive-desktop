{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainitive",
  "version": "1.0.0-beta.1",
  "identifier": "app.brainitive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": [
        "local",
        "settings",
        "capture",
        "switcher",
        "offline",
        "voice",
        "leader",
        "panel",
        "task"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Brainitive for your desktop",
    "longDescription": "Brainitive Desktop: boards, docs, whiteboards and plans of your Brainitive Cloud or self-hosted server in a native app.",
    "copyright": "© 2026 Armend Zekjiri (Brainitive)",
    "license": "BUSL-1.1",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Brainitive"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2 | libasound2t64"
        ],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER-UPDATER-PUBLIC-KEY-the-updater-stays-off-until-the-owner-pastes-the-real-public-key-from-npx-tauri-signer-generate-see-docs-RELEASING-md",
      "requireSignedVersion": true,
      "endpoints": [],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "brainitive"
        ]
      }
    }
  }
}
