{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainitive",
  "version": "0.1.0",
  "identifier": "app.brainitive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["local", "settings", "capture"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Brainitive for your desktop",
    "longDescription": "Brainitive Desktop: boards, docs, whiteboards and plans of your Brainitive Cloud or self-hosted server in a native app.",
    "copyright": "© 2026 Armend Zekjiri (Brainitive)",
    "license": "BUSL-1.1",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["brainitive"]
      }
    }
  }
}
